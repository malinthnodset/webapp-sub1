@model SubApp1.ViewModels.CreateQuizViewModel

@{
    ViewData["Title"] = "Create quiz";
}

<!--<link rel="stylesheet" href="~/css/quiz-create.css" asp-append-version="true" />-->

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <header class="mb-4">
            <h1>Create a quiz</h1>
            <p>Add the details, then write Question to help you study.</p>
        </header>

        <form asp-action="Create" method="post" class="create-quiz-form" novalidate>
            <!-- validation errors upon failed submit appear here - screen reader jumps up automatically -->
            <div asp-validation-summary="ModelOnly" class="create-quiz-summary" aria-live="assertive" aria-atomic="true"
                 tabindex="-1"></div>

            <!-- QUIZ DETAILS -->
            <fieldset class="card create-quiz-card mb-4" aria-labelledby="quiz-details-heading">
                <div class="card-body p-4">
                    <div class="d-flex align-items-start gap-3 mb-4">
                        <span class="create-quiz-step" aria-hidden="true">1</span>
                        <div>
                            <h2 id="quiz-details-heading" class="h5 fw-semibold mb-1">Quiz details</h2>
                            <p class="text-body-secondary small mb-0">Give your quiz a name and choose a course.</p>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-medium">Quiz title</label>
                        <input asp-for="Title" class="form-control" placeholder="e.g. Databases: SQL syntax"
                               aria-describedby="Title-error" required />
                        <span asp-validation-for="Title" id="Title-error" class="field-validation"
                              aria-live="polite"></span>
                    </div>


                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-medium">
                            Description <span class="optional-label">(optional)</span>
                        </label>
                        <textarea asp-for="Description" rows="3" class="form-control"
                                  placeholder="What will this quiz help you practise?"
                                  aria-describedby="Description-error"></textarea>
                        <span asp-validation-for="Description" id="Description-error" class="field-validation"
                              aria-live="polite"></span>
                    </div>

                    
                    <div>
                        <label asp-for="CourseId" class="form-label fw-medium">Course code</label>
                        <select asp-for="CourseId" asp-items="Model.Courses" class="form-select"
                                aria-describedby="CourseId-error" required>
                            <option value="">Choose a course</option>
                        </select>
                        <span asp-validation-for="CourseId" id="CourseId-error" class="field-validation"
                              aria-live="polite"></span>
                    </div>
                </div>
            </fieldset>

            <!-- QUIZ Question -->
            <fieldset class="card create-quiz-card mb-4" aria-labelledby="question-heading">
                <div class="card-body p-4">
                    <div class="d-flex align-items-start gap-3 mb-4">
                        <span class="create-quiz-step" aria-hidden="true">2</span>
                        <div>
                            <h2 id="question-heading" class="h5 fw-semibold mb-1">Your questions</h2>
                            <p class="text-body-secondary small mb-0">
                                Add a prompt, its correct answer, and how many points it is worth.
                            </p>
                        </div>
                    </div>


                    <div id="Question" class="d-grid gap-3">
                        @for (int i = 0; i < Model.Question.Count; i++)
                        {
                            <div class="question-item card" role="group" aria-labelledby="question-heading-@i">
                                <div class="card-body">
                                    <div class="d-flex align-items-center justify-content-between mb-3">
                                        <h3 id="question-heading-@i" class="h6 fw-semibold mb-0">Question @(i + 1)</h3>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge rounded-pill text-bg-light border">Text question</span>
                                            <button type="button" class="btn btn-sm btn-outline-danger remove-question"
                                                    aria-label="Remove question @(i + 1)">✕ Remove</button>
                                        </div>
                                    </div>

                                    <!-- PROMPT -->
                                    <div class="mb-3">
                                        <label asp-for="Question[i].Prompt" class="form-label fw-medium">Question
                                            prompt</label>
                                            <input asp-for="Question[i].Prompt" class="form-control"
                                                   placeholder="Write your question..."
                                                   aria-describedby="Question_@(i)__Prompt-error" required />
                                            <span asp-validation-for="Question[i].Prompt" id="Question_@(i)__Prompt-error"
                                                  class="field-validation" aria-live="polite"></span>
                                        </div>

                                        <!-- CORRECT ANSWER -->
                                        <div class="mb-3">
                                            <label asp-for="Question[i].CorrectAnswer" class="form-label fw-medium">Correct
                                                answer</label>
                                                <input asp-for="Question[i].CorrectAnswer" class="form-control"
                                                       placeholder="Enter the correct answer"
                                                       aria-describedby="Question_@(i)__CorrectAnswer-error" required />
                                                <span asp-validation-for="Question[i].CorrectAnswer"
                                                      id="Question_@(i)__CorrectAnswer-error" class="field-validation"
                                                      aria-live="polite"></span>
                                            </div>

                                            <!-- POINTS -->
                                            <div class="points-field">
                                                <label asp-for="Question[i].Points" class="form-label fw-medium">Points</label>
                                                <input asp-for="Question[i].Points" asp-format="{0:0.00}" class="form-control"
                                                       type="number" min="0" max="10" step="0.01"
                                                       aria-describedby="Question_@(i)__Points-help Question_@(i)__Points-error"
                                                       required />
                                                <span asp-validation-for="Question[i].Points" id="Question_@(i)__Points-error"
                                                      class="field-validation" aria-live="polite"></span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                            <button type="button" id="add-question" class="btn btn-outline-primary mt-4"
                                    aria-controls="Question">
                                <span aria-hidden="true">+</span> Add a question
                            </button>
                            <p id="question-limit-error" class="text-danger mt-2" role="alert" hidden></p>
                            <p id="question-announcement" class="visually-hidden" aria-live="polite" aria-atomic="true"></p>
                        </div>
                    </fieldset>


                    <div class="create-quiz-actions">
                        <a class="btn btn-secondary" asp-controller="Dashboard" asp-action="Index">Cancel</a>
                        <button type="submit" class="btn btn-primary">Save quiz</button>
                        <!-- TODO: (optional) add system status update "creating quiz" -> "quiz succesfully created" -->
                    </div>
                </form>
            </div>
        </div>

        @section Scripts {
            <script>
                const form = document.querySelector(".create-quiz-form");
                const questionContainer = document.getElementById("Question");
                const addQuestionButton = document.getElementById("add-question");
                const questionLimitError = document.getElementById("question-limit-error");
                const announcement = document.getElementById("question-announcement");

                let hasUnsavedChanges = false;

                document.querySelector(".create-quiz-summary.validation-summary-errors")?.focus();

                // Once user input something, register that there's unsaved input
                form.addEventListener("input", () => hasUnsavedChanges = true);

                // validation after adding/removing questions
                function refreshValidation() {
                    $(form).removeData("validator").removeData("unobtrusiveValidation");
                    $.validator.unobtrusive.parse(form);
                }

                // Browser warning if leaving page with unsaved changes
                window.addEventListener("beforeunload", (event) => {
                    if (!hasUnsavedChanges) return;
                    event.preventDefault();
                    event.returnValue = "";
                });

                // If submitted with no issues - validation is handled by vm and model
                form.addEventListener("submit", () => {
                    if ($(form).valid()) hasUnsavedChanges = false;
                });

                // Keep question indexes contiguous after adding or removing a card
                function renumberQuestions() {
                    const attrs = ["id", "name", "for", "aria-describedby", "aria-labelledby", "data-valmsg-for"];
                    const cards = questionContainer.querySelectorAll(".question-item");

                    cards.forEach((card, i) => {
                        card.setAttribute("aria-labelledby", `question-heading-${i}`);
                        card.querySelectorAll("*").forEach(el => {
                            for (const attr of attrs) {
                                const value = el.getAttribute(attr);
                                if (!value) continue;
                                el.setAttribute(attr, value
                                    .replace(/Question\[\d+\]/g, `Question[${i}]`)
                                    .replace(/Question_\d+__/g, `Question_${i}__`)
                                    .replace(/question-heading-\d+/g, `question-heading-${i}`));
                            }
                        });
                        card.querySelector("h3").textContent = `Question ${i + 1}`;
                        card.querySelector(".remove-question").setAttribute("aria-label", `Remove question ${i + 1}`);
                    });
                }

                // One listener on the container handles both server-rendered and newly added cards
                questionContainer.addEventListener("click", (event) => {
                    const button = event.target.closest(".remove-question");
                    if (!button) return;

                    if (questionContainer.querySelectorAll(".question-item").length <= 1) {
                        announcement.textContent = "A quiz must have at least one question.";
                        return;
                    }

                    button.closest(".question-item").remove();
                    renumberQuestions();
                    refreshValidation();
                    questionLimitError.hidden = true;
                    announcement.textContent = "Question removed.";
                    hasUnsavedChanges = true;
                });

                // Add question
                addQuestionButton.addEventListener("click", () => {
                    const i = questionContainer.querySelectorAll(".question-item").length;
                    if (i >= 50) {
                        questionLimitError.textContent = "A quiz can have at most 50 questions.";
                        questionLimitError.hidden = false;
                        return;
                    }

                    const templateCard = questionContainer.querySelector(".question-item");
                    if (!templateCard) return;

                    questionLimitError.hidden = true;
                    const newCard = templateCard.cloneNode(true);
                    newCard.querySelectorAll("input, textarea").forEach(input => {
                        input.value = input.name.endsWith(".Points") ? "1.00" : "";
                        input.classList.remove("input-validation-error");
                        input.removeAttribute("aria-invalid");
                    });
                    newCard.querySelectorAll(".field-validation").forEach(message => {
                        message.textContent = "";
                        message.classList.remove("field-validation-error");
                        message.classList.add("field-validation-valid");
                    });

                    questionContainer.append(newCard);
                    renumberQuestions();
                    refreshValidation();

                    document.getElementById(`Question_${i}__Prompt`).focus(); // keyboard nav
                    announcement.textContent = `Question ${i + 1} added.`;
                    hasUnsavedChanges = true;
                });
            </script>
        
            <partial name="_ValidationScriptsPartial" />
        }