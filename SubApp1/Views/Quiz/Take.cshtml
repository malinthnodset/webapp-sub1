<!-- [LEARN] Take quiz view model -->
@model SubApp1.ViewModels.TakeQuizViewModel

@{
    // [LEARN] Show quiz title in layout
    ViewData["Title"] = Model.Title;
}

<!-- [LEARN] Take CSS -->
<link rel="stylesheet" href="~/quiz-take.css" asp-append-version="true" />

<!-- [LEARN] HTML setup for the quiz itself -->
<main class="take-quiz-page">
<!-- [LEARN] Main -->
<div class="take-quiz-shell">
<!-- [LEARN] Shell -->
<header class="take-quiz-heading">
<!-- [LEARN] Header -->
<p class="take-quiz-kicker">QUIZ IN PROGRESS</p>
<!-- [LEARN] Kicker -->
<h1>@Model.Title</h1>
<!-- [LEARN] Title -->
<div class="take-quiz-progress-copy">
<!-- [LEARN] Progress copy -->
<span id="question-counter" aria-live="polite">Question 1 of @Model.Questions.Count</span>
<!-- [LEARN] Counter -->
<span>Move at your own pace</span>
<!-- [LEARN] Note -->
</div>
<div class="take-quiz-progress" role="progressbar" aria-label="Quiz progress" aria-valuemin="1" aria-valuemax="@Model.Questions.Count" aria-valuenow="1">
<!-- [LEARN] Progress bar -->
<div class="take-quiz-progress-bar" id="question-progress"></div>
<!-- [LEARN] Bar -->
</div>
</header>

<form asp-controller="Quiz" asp-action="Submit" method="post" id="take-quiz-form">
<!-- [LEARN] Submit form -->
@Html.AntiForgeryToken()
<!-- [LEARN] CSRF token -->
<input type="hidden" asp-for="QuizId" />
<!-- [LEARN] Quiz id hidden -->

<div asp-validation-summary="ModelOnly" role="alert" class="take-quiz-summary"></div>
<!-- [LEARN] Validation summary -->

@for (var index = 0; index < Model.Questions.Count; index++)
{
<section class="question-card @(index == 0 ? "is-active" : string.Empty)"
 data-question-step="@index" aria-hidden="@(index == 0 ? "false" : "true")">
<!-- [LEARN] Question card -->
<div class="question-card-topline">
<!-- [LEARN] Topline -->
<span>QUESTION @(index + 1)</span>
<!-- [LEARN] Number -->
<span>@(index == Model.Questions.Count - 1 ? "Last question" : $"{Model.Questions.Count - index - 1} left")</span>
<!-- [LEARN] Remaining -->
</div>
<h2 class="question-prompt" tabindex="-1">@Model.Questions[index].Prompt</h2>
<!-- [LEARN] Prompt -->

<input type="hidden" asp-for="Questions[index].QuestionId" />
<!-- [LEARN] Question id hidden -->
@if (Model.Questions[index].Options.Count > 0)
{
<fieldset class="answer-options mb-3">
<!-- [LEARN] Options -->
<legend class="answer-label">Choose one answer</legend>
<!-- [LEARN] Legend -->
@for (var optionIndex = 0; optionIndex < Model.Questions[index].Options.Count; optionIndex++)
{
var option = Model.Questions[index].Options[optionIndex];
<!-- [LEARN] Option -->
var inputId = $"question-{Model.Questions[index].QuestionId}-option-{optionIndex}";
<!-- [LEARN] Input id -->
<div class="form-check">
<!-- [LEARN] Check -->
<input class="form-check-input" type="radio" name="Questions[@index].SubmittedAnswer" id="@inputId" value="@option" checked="@(Model.Questions[index].SubmittedAnswer == option ? "checked" : null)" />
<!-- [LEARN] Radio -->
<label class="form-check-label" for="@inputId">@option</label>
<!-- [LEARN] Label -->
</div>
}
</fieldset>
}
else
{
<label class="answer-label" asp-for="Questions[index].SubmittedAnswer">Your answer</label>
<!-- [LEARN] Label -->
<textarea class="form-control answer-input" asp-for="Questions[index].SubmittedAnswer" rows="5" placeholder="Write your answer here..."></textarea>
<!-- [LEARN] Textarea -->
}
<span asp-validation-for="Questions[index].SubmittedAnswer" class="field-validation"></span>
<!-- [LEARN] Validation -->
<p class="question-client-error" data-question-error role="alert"></p>
<!-- [LEARN] Client error -->
</section>
}

<footer class="take-quiz-controls">
<!-- [LEARN] Footer -->
<button class="quiz-nav-button quiz-nav-previous" id="previous-question" type="button" disabled>
<!-- [LEARN] Previous -->
<span aria-hidden="true">&larr;</span> Previous
</button>
<div class="quiz-nav-next-group">
<!-- [LEARN] Next group -->
<button class="quiz-nav-button quiz-nav-next" id="next-question" type="button">
<!-- [LEARN] Next -->
Next <span aria-hidden="true">&rarr;</span>
</button>
<button class="quiz-nav-button quiz-nav-submit" id="submit-quiz" type="submit" hidden>
<!-- [LEARN] Submit -->
Submit quiz
</button>
</div>
</footer>
</form>
</div>
</main>

<!-- [LEARN] JS features of the webpages for taking the quiz -->
<script>
// [LEARN] IIFE
(() => {
const form = document.getElementById("take-quiz-form"); // [LEARN] Form element
const panels = Array.from(document.querySelectorAll("[data-question-step]")); // [LEARN] Question panels
const previousButton = document.getElementById("previous-question"); // [LEARN] Prev button
const nextButton = document.getElementById("next-question"); // [LEARN] Next button
const submitButton = document.getElementById("submit-quiz"); // [LEARN] Submit button
const counter = document.getElementById("question-counter"); // [LEARN] Counter
const progress = document.getElementById("question-progress"); // [LEARN] Progress bar
const progressTrack = progress.parentElement; // [LEARN] Progress track
let activeIndex = 0; // [LEARN] Active question index

if (!form || panels.length === 0) return; // [LEARN] Guard

// [LEARN] Check if answered
const questionIsAnswered = (panel) => {
const selectedOption = panel.querySelector('input[type="radio"]:checked'); // [LEARN] Selected radio
if (selectedOption) return true; // [LEARN] Answered

const answer = panel.querySelector("textarea"); // [LEARN] Textarea
return answer !== null && answer.value.trim().length > 0; // [LEARN] Has text
};

// [LEARN] Show question
const showQuestion = (index, moveFocus = true) => {
activeIndex = Math.max(0, Math.min(index, panels.length - 1)); // [LEARN] Clamp index
panels.forEach((panel, panelIndex) => { // [LEARN] Toggle panels
panel.classList.toggle("is-active", panelIndex === activeIndex); // [LEARN] Active class
panel.setAttribute("aria-hidden", panelIndex === activeIndex ? "false" : "true"); // [LEARN] Aria
});

previousButton.disabled = activeIndex === 0; // [LEARN] Disable prev on first
nextButton.hidden = activeIndex === panels.length - 1; // [LEARN] Hide next on last
submitButton.hidden = activeIndex !== panels.length - 1; // [LEARN] Show submit on last
counter.textContent = `Question ${activeIndex + 1} of ${panels.length}`; // [LEARN] Update counter
progress.style.width = `${((activeIndex + 1) / panels.length) * 100}%`; // [LEARN] Update progress
progressTrack.setAttribute("aria-valuenow", String(activeIndex + 1)); // [LEARN] Aria value

if (moveFocus) panels[activeIndex].querySelector(".question-prompt").focus(); // [LEARN] Focus prompt
};

// [LEARN] Validate question
const validateQuestion = (panel) => {
const error = panel.querySelector("[data-question-error]"); // [LEARN] Error element
if (questionIsAnswered(panel)) { // [LEARN] Answered?
error.textContent = ""; // [LEARN] Clear error
return true; // [LEARN] Valid
}

error.textContent = "Please enter an answer before continuing."; // [LEARN] Error message
const answerInput = panel.querySelector("textarea, input[type='radio']"); // [LEARN] Input
if (answerInput) answerInput.focus(); // [LEARN] Focus input
return false; // [LEARN] Invalid
};

previousButton.addEventListener("click", () => showQuestion(activeIndex - 1)); // [LEARN] Prev click
nextButton.addEventListener("click", () => { // [LEARN] Next click
if (validateQuestion(panels[activeIndex])) showQuestion(activeIndex + 1); // [LEARN] Validate then next
});
form.addEventListener("submit", (event) => { // [LEARN] Submit handler
const firstUnansweredIndex = panels.findIndex((panel) => !questionIsAnswered(panel)); // [LEARN] First unanswered
if (firstUnansweredIndex !== -1) { // [LEARN] Unanswered exists
event.preventDefault(); // [LEARN] Prevent submit
showQuestion(firstUnansweredIndex); // [LEARN] Go to it
validateQuestion(panels[firstUnansweredIndex]); // [LEARN] Validate
}
});

showQuestion(0, false); // [LEARN] Init first question
})();
</script>
