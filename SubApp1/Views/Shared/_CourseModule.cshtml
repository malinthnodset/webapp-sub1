<!-- [LEARN] Dynamic model -->
@model IEnumerable<dynamic>

<div class="course-modules">
<!-- [LEARN] Container -->
    @if (Model != null)
    {
        foreach (var module in Model)
        {
            <details class="course-module">
            <!-- [LEARN] Collapsible -->
                <summary class="course-module__title">@module.Title</summary>
                <!-- [LEARN] Title -->
                <div class="course-module__quizzes">
                <!-- [LEARN] Quizzes -->
                    @foreach (var quiz in module.Quizzes)
                    {
                        <a class="course-module__quiz"
                           asp-controller="Quiz"
                           asp-action="Details"
                           asp-route-id="@quiz.Id">
                        <!-- [LEARN] Quiz link -->
                            @quiz.Title
                            <!-- [LEARN] Title -->
                        </a>
                    }
                </div>
            </details>
        }
    }
</div>

<style>
/* [LEARN] Inline CSS */
    .course-module {
    /* [LEARN] Module */
        margin-bottom: .75rem;
        border: 1px solid #d1d5db;
        border-radius: .5rem;
        overflow: hidden;
    }

    .course-module__title {
    /* [LEARN] Title */
        padding: 1rem;
        background: #f3f4f6;
        cursor: pointer;
        font-weight: 600;
    }

    .course-module__quizzes {
    /* [LEARN] Quizzes */
        display: flex;
        flex-wrap: wrap;
        gap: .75rem;
        padding: 1rem;
    }

    .course-module__quiz {
    /* [LEARN] Quiz link */
        flex: 1 1 180px;
        padding: .85rem 1rem;
        border: 1px solid #d1d5db;
        border-radius: .375rem;
        color: inherit;
        text-decoration: none;
    }

    .course-module__quiz:hover {
    /* [LEARN] Hover */
        background: #f9fafb;
    }
</style>
